        "php": "^8.0",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.6",
        "slim/twig-view": "^3.3",
        "ext-ldap": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
